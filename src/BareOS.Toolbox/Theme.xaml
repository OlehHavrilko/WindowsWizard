<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Палитра из branding/src/palette.json (тёмная тема first). -->
  <Color x:Key="GraphiteC">#101113</Color>
  <Color x:Key="SlateC">#1A1C1F</Color>
  <Color x:Key="BoneC">#ECEAE4</Color>
  <Color x:Key="StoneC">#8F8D87</Color>
  <Color x:Key="SignalC">#3DDC97</Color>
  <Color x:Key="PaperC">#F4F2EC</Color>
  <Color x:Key="AshC">#5E5C57</Color>
  <Color x:Key="SignalDeepC">#127A50</Color>
  <Color x:Key="EmberC">#FFB547</Color>
  <Color x:Key="HexC">#FF5A6E</Color>
  <SolidColorBrush x:Key="Graphite" Color="{StaticResource GraphiteC}" />
  <SolidColorBrush x:Key="Paper" Color="{StaticResource PaperC}" />
  <SolidColorBrush x:Key="Ash" Color="{StaticResource AshC}" />
  <SolidColorBrush x:Key="SignalDeep" Color="{StaticResource SignalDeepC}" />
  <SolidColorBrush x:Key="Slate" Color="{StaticResource SlateC}" />
  <SolidColorBrush x:Key="Raised" Color="#23262A" />
  <SolidColorBrush x:Key="Line" Color="#2A2D31" />
  <SolidColorBrush x:Key="Bone" Color="{StaticResource BoneC}" />
  <SolidColorBrush x:Key="Stone" Color="{StaticResource StoneC}" />
  <SolidColorBrush x:Key="Signal" Color="{StaticResource SignalC}" />
  <SolidColorBrush x:Key="Ember" Color="{StaticResource EmberC}" />
  <SolidColorBrush x:Key="Hex" Color="{StaticResource HexC}" />

  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Bone}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
  </Style>

  <!-- Переключатель: квадратный, без анимаций; включён = Signal. -->
  <Style x:Key="Switch" TargetType="ToggleButton">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Border x:Name="Track" Background="Transparent" BorderBrush="{StaticResource Stone}" BorderThickness="1.5" CornerRadius="3" />
            <Border x:Name="Knob" Width="14" Height="14" CornerRadius="2" Background="{StaticResource Stone}" HorizontalAlignment="Left" Margin="4,0,0,0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Signal}" />
              <Setter TargetName="Track" Property="Background" Value="#1F3A30" />
              <Setter TargetName="Knob" Property="Background" Value="{StaticResource Signal}" />
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.35" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Btn" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Bone}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="B" Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Signal}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Foreground" Value="{StaticResource Graphite}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="B" Background="{StaticResource Signal}" CornerRadius="3" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontWeight="SemiBold" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="B" Property="Opacity" Value="0.88" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TabBtn" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource Stone}" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Margin" Value="0,0,22,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="B" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="0,6">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Signal}" />
              <Setter Property="Foreground" Value="{StaticResource Bone}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Bone}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{StaticResource Slate}" />
    <Setter Property="Foreground" Value="{StaticResource Bone}" />
    <Setter Property="CaretBrush" Value="{StaticResource Signal}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
  </Style>
</ResourceDictionary>
